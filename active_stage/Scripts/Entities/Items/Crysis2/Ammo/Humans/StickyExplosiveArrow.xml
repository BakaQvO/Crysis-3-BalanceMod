<ammo name="StickyExplosiveArrow" class="StickyExplosiveBowArrow">
	<geometry>
    <firstperson name="objects/weapons/us/bow/arrow_explosive.cgf" GAME="SP" />
	<firstperson name="objects/multiplayer/weapons/us/bow/arrow_explosion_mp.cgf" GAME="MP" />
	</geometry>
	<flags>
		<param name="serverspawn" value="1" />
		<param name="predictspawn" value="1" />
	</flags>
	<whiz>
		<param name="sound" value="sounds/physics_bullets:whizzes:arrow_whiz_explosive" GAME="SP" />
		<param name="sound" value="sounds/physics_bullets:whizzes:arrow_whiz_explosive_mp" GAME="MP" />
		<param name="distance" value="10.0" GAME="SP"/>
		<param name="distance" value="10.0" GAME="MP"/>
	</whiz>
	<ricochet>
		<param name="sound" value="sounds/physics_bullets:ricochets:bullet_ricochet" />
	</ricochet>
	<physics type="particle">
    <param name="mass" value="0.3"  GAME="SP"/>
    <param name="mass" value="1.0"  GAME="MP"/>    
    <param name="speed" value="50" GAME="SP"  />
    <param name="speed" value="800" GAME="MP"  />	
    <param name="radius" value="0.125" />
    <param name="water_resistance" value="0.5" />
		<param name="air_resistance" value="0.0" />      
    <param name="gravity" value="0, 0, -3.0" GAME="SP" />
    <param name="gravity" value="0, 0, -8.0" GAME="MP" />
    <param name="no_spin" value="1" />
    <param name="thrust" value="0" />
    <param name="lift" value="0" />
    <param name="min_bounce_speed" value="0.1" />
    <param name="material" value="mat_grenade_LTAG" />
    <param name="spin_random" value="0,0,0" />
	<param name="single_contact" value ="1" GAME="MP"/>
    <param name="constant_orientation" value ="1" GAME="MP"/>
    <param name="traceable" value="1" />
    <param name="pierceability" value="9" />
	</physics>
	<explosion>
		<param name="pressure" value="15000" />
		<param name="min_radius" value="1" GAME="SP"/>
		<param name="min_radius" value="1" GAME="MP"/>
		<param name="max_radius" value="8" GAME="SP"/>
		<param name="max_radius" value="4" GAME="MP"/>
		<param name="sound_radius" value="150" GAME="SP"/>
		<param name="min_phys_radius" value="2.2" />
		<param name="max_phys_radius" value="3" />
		<param name="hole_size" value="2" />
		<param name="terrain_hole_size" value="3" />
		<param name="radialblurdist" value="30" GAME="SP"/>
		<param name="radialblurdist" value="10" GAME="MP"/>
		<param name="type" value="frag" />
		<param name="friendly_fire" value="team" GAME="SP"/>
	</explosion>
	<params>
    <param name="ammo_category" value="bow" />
    <param name="display_name" value="@mp_eArrow" />
		<param name="lifetime" value="1.5" GAME="SP"/>
		<param name="lifetime" value="3.0" GAME="MP"/>		
		<param name="showtime" value="0.0" />
		<param name="hitRecoil" value="Level5" GAME="SP"/>
		<param name="hitRecoilArmorMode" value="Level3" GAME="SP"/>
		<param name="hitRecoil" value="Level3_mp" GAME="MP"/>
		<param name="hitRecoilArmorMode" value="Level1_mp" GAME="MP"/>
    <param name="quietRemoval" value="0" />
    <param name="trackOnHUD" value="1"/>
	</params>
	<trail>
		<param name="effect" value="Crysis3_weapon_bow.tracer.trail_mp" GAME="MP" />
		<param name="scale"  value="0.5" GAME="MP" />		
	</trail>		
	<trailUnderWater>
		<param name="effect" value="Crysis2_generic.water.bullet_bubbles" />
		<param name="scale"  value="3.0" />
	</trailUnderWater>
	<BulletTimeParams GAME="MP" >
		<param name="geometry" value="objects/multiplayer/weapons/us/bow/arrow_explosion_mp.cgf"/>
		<param name="effect" value="cw2_gameplay.killcam.4mmsabot"/>
	</BulletTimeParams>
</ammo>

